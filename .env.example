# Frontend runtime: set on Sites, never put API secrets in NEXT_PUBLIC variables.
CONVEX_URL=
# Sites worker only: signing key stays secret; never put it in frontend variables.
PANTRY_AUTH_ISSUER=
PANTRY_AUTH_PRIVATE_JWK=

# Set these on your Convex deployment, not the frontend.
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Comma-separated test recipients; required until verified email auth is added.
AGENTMAIL_ALLOWED_RECIPIENTS=
